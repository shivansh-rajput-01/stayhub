{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "functions": {
    "app.js": {
      "includeFiles": [
        "views/**",
        "public/**",
        "models/**",
        "controllers/**",
        "routes/**",
        "utils/**"
      ]
    }
  },
  "installCommand": "npm install --legacy-peer-deps"
}