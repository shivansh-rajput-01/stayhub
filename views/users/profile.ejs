<% layout("./layouts/boilerplate") -%>

    <body>
        <h3>@<%= user.username %>
        </h3>
        <p>
            <%= listings.length %> Listings created
        </p>
        <% if(listings.length){ %>
            <div class="benefits">
                <div class="benefit shadow-lg">
                    <p class="medium">Average Number of Reviews</p>
                    <div style="text-align: center;">
                        <i class="fa-solid fa-comment" style="color:#0D9488; font-size: 3rem;"></i> 
                    </div>
                    <p><span style="font-size: 1.2rem; margin-right: 5px;">
                            <%= avgNumber.toFixed(2) %>
                        </span><i style="font-size: 0.9rem;"></i></p>
                    <p>reviews/listing</p>
                </div>
                <div class="benefit shadow-lg">
                    <p class="medium">Average Review</p>
                    <div style="text-align: center;">
                        <i class="fa-solid fa-star" style="color:gold; font-size: 3rem;"></i> 
                    </div>
                    <p><span style="font-size: 1.2rem; margin-right: 5px;">
                            <%= avgReview.toFixed(2) %>
                        </span><i style="font-size: 0.9rem;"></i></p>
                    <p>avg rating/listing</p>
                </div>
                <div class="benefit shadow-lg">
                    <p class="medium">Maximum Number of Reviews on a
                        listing</p>
                    <div style="text-align: center;">
                        <i class="fa-solid fa-trophy" style="color:grey; font-size: 3rem;"></i> 
                    </div>
                    <p><span style="font-size: 1.2rem; margin-right: 5px;">
                            <%= maxReview %>
                        </span><i style="font-size: 0.9rem;"></i></p>
                    <p>Reviews</p>
                </div>
            </div>
            <div class="mobile hide">
                <ol>
                    <li>
                        <p class="medium"><i class="fa-solid fa-comment" style="color:#0D9488;"></i> Average Number of Reviews
                        </p>
                        <p><span style="font-size: 1.2rem; margin-right: 5px;">
                                <%= avgNumber.toFixed(2) %>
                            </span><i style="font-size: 0.9rem;">reviews/listing</i></p>
                    </li>
                    <hr>
                    <li>
                        <p class="medium"><i class="fa-solid fa-star" style="color:gold;"></i> Average Review</p>
                        <p><span style="font-size: 1.2rem; margin-right: 5px;">
                                <%= avgReview.toFixed(2) %>
                            </span><i style="font-size: 0.9rem;">avg rating/listing</i></p>
                    </li>
                    <hr>
                    <li>
                        <p class="medium"><i class="fa-solid fa-trophy" style="color:grey;"></i> Maximum Number of Reviews
                            on a listing</p>
                        <p><span style="font-size: 1.2rem; margin-right: 5px;">
                                <%= maxReview %>
                            </span><i style="font-size: 0.9rem;">Reviews</i></p>
                    </li>
                </ol>
            </div>
            <h3 class="mt-4">Your Listings</h3>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
                <% let idx=0; %>
                    <%for(let listing of listings){%>
                        <div class="col">
                            <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                                <div class="card listing-card" style="width: 25rem;">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="property photo">
                                    <div class="card-img-overlay"></div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            <%= listing.title %>
                                                <p class="card-text d-lg-inline">
                                                    <% if(listing.avgRating){ %>
                                                        <% let arr=starRatingArray(listing.avgRating) %>
                                                            <% for(let i=0; i<5; i++){ %>
                                                                <svg width="20px" height="20px">
                                                                    <defs>
                                                                        <linearGradient id=<%=`starfill-${i}-${idx}` %>
                                                                            x1="0%" y1="0%" x2="100%" y2="0%">
                                                                            <stop offset=<%=arr[i] %> stop-color="#FFD700"/>
                                                                                <stop offset=<%=arr[i] %>
                                                                                    stop-color="grey"/>
                                                                        </linearGradient>
                                                                    </defs>
                                                                    <path
                                                                        d="M 10 0 L 8 8 L 0 8 L 6 12 L 4 20 L 10 16 L 16 20 L 14 12 L 20 8 L 12 8 Z"
                                                                        fill="url(#<%= `starfill-${i}-${idx}` %>)" />
                                                                </svg>
                                                                <% if(i==4){ %>
                                                                    (<%= listing.reviews.length %>)
                                                                        <% } %>
                                                                            <% } %>
                                                                                <% } %>
                                                </p>
                                                <% if(!listing.avgRating || listing.avgRating==0){ %>
                                                    No reviews added yet
                                                    <% } %>
                                                        <p class="price">₹<%= listing.price.toLocaleString("en-IN") %>
                                                        </p>
                                                        <p class="tax-price hide">₹<%= (listing.price *
                                                                1.18).toLocaleString("en-IN") %>
                                                        </p>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% idx++; %>
                            <%}%>
            </div>
        <% } %>
        <% if(!listings.length){ %>
            <p>No listings to display</p>
        <% } %>
    </body>