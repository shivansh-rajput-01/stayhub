<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show mt-3 offset-lg-3 col-lg-6" role="alert">
        <p><%= success %></p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show mt-3 offset-lg-3 col-lg-6" role="alert">
        <p><%= error %></p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>