<% layout("./layouts/boilerplate") -%>
<body>
    <div class="container">
        <div class="card border-0 show-card offset-4" style="width: 32rem;">
            <img src="<%= listing.image %>" class="card-img-top" alt="property photo">
            <div class="card-body">
                <h5 class="card-title"><%= listing.title %></h5>
                <p class="card-text"><%= listing.description %></p>
                <p class="card-text">Price: ₹ <%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text">Location: <%= listing.location %></p>
                <p class="card-text">Country: <%= listing.country %></p>
                <form action="/listings/<%= listing._id %>/edit" class="i-flex">
                    <button class="btn btn-edit">Edit</button>
                </form>
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="i-flex">
                    <button class="btn btn-delete">Delete</button>
                </form>
            </div>
        </div>
    </div>
</body>