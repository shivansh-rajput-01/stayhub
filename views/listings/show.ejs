<% layout("./layouts/boilerplate") -%>
<body>
    <div class="container">
        <div class="card border-0 show-card offset-lg-4" style="width: 32rem;">
            <img src="<%= listing.image %>" class="card-img-top" alt="property photo">
            <div class="card-body">
                <h5 class="card-title"><%= listing.title %></h5>
                <p class="card-text"><%= listing.description %></p>
                <p class="card-text">Price: ₹ <%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text">Location: <%= listing.location %></p>
                <p class="card-text">Country: <%= listing.country %></p>
                <form action="/listings/<%= listing._id %>/edit" class="i-flex">
                    <button class="btn btn-edit">Edit</button>
                </form>
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="i-flex">
                    <button class="btn btn-delete">Delete</button>
                </form>
                <hr>
            </div>
        </div>
        <div class="offset-lg-4" style="width: 32rem;">
            <h4>Give Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation" novalidate>
                <div>
                    <label for="rating" class="form-label">Ratings(1-5)</label>
                    <input type="range" min="1" max="5" class="form-range" id="rating" name="rating" required>
                </div>
                <div>
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="comment" id="comment" class="form-control" row="5" placeholder="Give feedback" required></textarea>
                    <div class="invalid-feedback">
                        Enter a feedback!
                    </div>
                </div>
                <div>
                   <button class="btn btn-outline-dark">Add Review</button> 
                </div>
            </form>
            <hr>
        </div>
        <div class="offset-lg-4" style="width: 32rem;">
            <h4>Reviews</h4>
            <% if(listing.reviews.length == 0) { %>
                <p>No reviews added yet</p>
            <% } %>
            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="card col-lg-5 ms-2" style="width: 15rem;">
                        <div class="card-body">
                            <h5 class="card-title">Rahul Kumar</h5>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="card-text"><%= review.rating %> stars</p>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>