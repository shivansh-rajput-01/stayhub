<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/listings" method="POST">
        <label for="title">Title: </label>
        <input type="text" name="title" id="title" placeholder="Enter listing title" required>
        <br><br>
        <label for="description">Description: </label>
        <input type="text" name="description" id="description" placeholder="Enter listing description">
        <br><br>
        <label for="image">Image: </label>
        <input type="text" name="image" id="image" placeholder="Enter listing image link">
        <br><br>
        <label for="price">Price: </label>
        <input type="number" name="price" id="price" placeholder="Enter listing price">
        <br><br>
        <label for="location">Location: </label>
        <input type="text" name="location" id="location" placeholder="Enter listing location">
        <br><br>
        <label for="country">Country: </label>
        <input type="text" name="country" id="country" placeholder="Enter listing country">
        <br><br>
        <button>Add Listing</button>
    </form>
</body>
</html>