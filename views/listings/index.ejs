<% layout("./layouts/boilerplate") -%>
<body>
    <div class="filter-box mt-3">
        <div id="filters">
            <div class="filter">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
            <div class="filter">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </div>
        </div>
        <div class="hide" id="filter-input">
            <form action="/listings/filters" class="d-flex">
                <select class="form-select" name="infilter" id="filter-dropdown" required>
                    <option value="" disabled selected>Filters</option>
                    <option value="trending">Trending</option>
                    <option value="rooms">Rooms</option>
                    <option value="iconic-cities">Iconic Cities</option>
                    <option value="mountains">Mountains</option>
                    <option value="amazing-pools">Amazing Pools</option>
                    <option value="camping">Camping</option>
                    <option value="farms">Farms</option>
                    <option value="arctic">Arctic</option>
                </select>
                <button class="filter-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
        </div>
        <div class="tax-switch">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Show Price after Tax</label>
            </div>
        </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
        <% let idx = 0; %>
        <%for(let listing of listings){%>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                    <div class="card listing-card" style="width: 25rem;">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="property photo">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <%= listing.title %>
                                <p class="card-text d-lg-inline">
                                    <% if(listing.avgRating){ %>
                                        <% let arr = starRatingArray(listing.avgRating) %>
                                            <% for(let i=0; i<5; i++){ %>
                                                <svg width="20px" height="20px">
                                                    <defs>
                                                        <linearGradient id=<%= `starfill-${i}-${idx}` %> x1="0%" y1="0%" x2="100%" y2="0%">
                                                            <stop offset=<%= arr[i] %> stop-color="#FFD700"/>
                                                                <stop offset=<%= arr[i] %> stop-color="grey"/>
                                                        </linearGradient>
                                                    </defs>
                                                    <path
                                                    d="M 10 0 L 8 8 L 0 8 L 6 12 L 4 20 L 10 16 L 16 20 L 14 12 L 20 8 L 12 8 Z"
                                                    fill="url(#<%= `starfill-${i}-${idx}` %>)"
                                                    />
                                                </svg>
                                                <% if(i==4){ %>
                                                    (<%= listing.reviews.length %>)
                                                <% } %>
                                            <% } %>
                                    <% } %>
                                </p>
                                <% if(!listing.avgRating || listing.avgRating==0){ %>
                                    No reviews added yet
                                <% } %>
                                <p class="price">₹<%= listing.price.toLocaleString("en-IN") %> /night</p>
                                <p class="tax-price hide">₹<%= (listing.price * 1.18).toLocaleString("en-IN") %> /night</p>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
            <% idx++; %>
        <%}%>
    </div>
    <script>
        let switchBtn = document.querySelector("#switchCheckDefault");
        let priceBox = document.querySelectorAll(".price");
        let taxPriceBox = document.querySelectorAll(".tax-price");
        let taxes = false;
        switchBtn.addEventListener("click", () => {
            for (let p of priceBox) {
                p.classList.toggle("hide");
            }
            for (let t of taxPriceBox) {
                t.classList.toggle("hide");
            }
        });
    </script>
    <script src="/js/filter.js"></script>
</body>