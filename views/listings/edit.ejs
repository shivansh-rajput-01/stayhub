<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayHub</title>
</head>
<body>
    <h1>Edit Listing</h1>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
        <label for="title">Title: </label>
        <input type="text" name="title" id="title" value="<%=listing.title%>">
        <br><br>
        <label for="description">Description: </label>
        <textarea type="text" name="description" id="description" rows = 10 cols = 50 ><%=listing.description%></textarea>
        <br><br>
        <label for="image">Image: </label>
        <input type="text" name="image" id="image" value="<%=listing.image%>">
        <br><br>
        <label for="price">Price: </label>
        <input type="number" name="price" id="price" value="<%=listing.price%>">
        <br><br>
        <label for="location">Location: </label>
        <input type="text" name="location" id="location" value="<%=listing.location%>">
        <br><br>
        <label for="country">Country: </label>
        <input type="text" name="country" id="country" value="<%=listing.country%>">
        <br><br>
        <button>Edit</button>
    </form>
</body>
</html>