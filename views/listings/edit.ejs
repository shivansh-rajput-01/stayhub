<% layout("./layouts/boilerplate") -%>
<body>
    <div class="container mt-3 mb-3">
       <h3 class="offset-3">Edit Listing</h3>
        <div class="row">
            <div class="col-md-6 offset-md-3">
                <form action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" method="POST" novalidate>
                    <div>
                        <label for="title" class="form-label">Title </label>
                        <input type="text" name="title" id="title" value="<%=listing.title%>" class="form-control" required>
                        <div class="invalid-feedback">
                            Title cannot be empty
                        </div>
                    </div>
                    <div>
                        <label for="description" class="form-label">Description </label>
                        <textarea type="text" name="description" id="description" class="form-control" required><%=listing.description%></textarea>
                        <div class="invalid-feedback">
                            Description cannot be empty
                        </div>
                    </div>
                    <div>
                        <label for="image" class="form-label">Image </label>
                        <input type="text" name="image" id="image" value="<%=listing.image%>" class="form-control" required>
                        <div class="invalid-feedback">
                            Image cannot be empty
                        </div>
                    </div>
                    <div>
                        <div class="row">
                            <div class="col-4">
                                <label for="price" class="form-label">Price </label>
                                <input type="number" name="price" id="price" value="<%=listing.price%>" class="form-control" required>
                                <div class="invalid-feedback">
                                    Price cannot be empty
                                </div>
                            </div>
                            <div class="col-8">
                                <label for="location" class="form-label">Location </label>
                                <input type="text" name="location" id="location" value="<%=listing.location%>" class="form-control" required>
                                <div class="invalid-feedback">
                                    Location cannot be empty
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label for="country" class="form-label">Country </label>
                        <input type="text" name="country" id="country" value="<%=listing.country%>" class="form-control" required>
                        <div class="invalid-feedback">
                            Country cannot be empty
                        </div>
                    </div>
                    <button class="btn btn-edit">Edit</button>
                </form>
            </div>
        </div>
   </div>
</body>